# Copie ce fichier vers .env et remplis tes vraies valeurs.
# .env est dans .gitignore — ne jamais le commiter.

GEMINI_API_KEY=ta_cle_gemini_ici
GEMINI_MODEL=gemini-2.5-flash

IMAGE_API_BASE_URL=https://image.pollinations.ai/prompt

DATABASE_URL=sqlite:///./kora.db

CORS_ORIGINS=http://localhost:5173

# Optionnel — active les suggestions basées sur ton activité GitHub réelle.
# GITHUB_TOKEN n'est pas obligatoire (60 requêtes/h suffisantes en usage
# personnel), mais recommandé si tu génères des suggestions souvent :
# https://github.com/settings/tokens (aucun scope nécessaire pour du public)
GITHUB_USERNAME=ton_pseudo_github
GITHUB_TOKEN=
